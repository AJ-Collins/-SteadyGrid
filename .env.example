# Postgres (local docker: port 5433 / production: managed Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/steadygrid?schema=public"
# Auth — 32+ char secret, required for session JWT signing
AUTH_SECRET="change-me-to-a-32-plus-char-secret-in-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Subdomain gateway (src/middleware.ts): apex serves web, admin.* serves
# the admin app, cms.* serves the CMS app. Local dev mirrors this with
# admin.localhost:3000 and cms.localhost:3000 — add one line to /etc/hosts:
#   127.0.0.1 localhost admin.localhost cms.localhost
SITE_APEX_DOMAIN="steadygrid.com"
# Shares one login across apex + subdomains in production.
# Leave empty for localhost (browsers reject Domain on bare hostnames).
SITE_COOKIE_DOMAIN=""
# Rate limiting: Redis when set (shared across instances), in-memory
# otherwise. Fail-open: a dead store never blocks traffic.
REDIS_URL="redis://localhost:6379"
# Trust proxy IP headers (X-Forwarded-For / X-Real-IP) for rate-limit keys.
# REQUIRED in production behind nginx/CDN — without it every client buckets
# to "unknown" and shares one limit. The nginx edge overwrites these headers
# from the real connection IP (see infrastructure/nginx/steadygrid.conf).
TRUSTED_PROXIES="10.0.0.0/8"
# Object storage — "minio" (default, S3-compatible) or "local" (disk).
# "s3" is accepted as an alias of "minio" for generic S3 endpoints.
STORAGE_DRIVER="minio"
# MinIO S3 API endpoint (docker-compose maps 9000 API / 9001 console)
MINIO_ENDPOINT="127.0.0.1"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_REGION="us-east-1"
MINIO_BUCKET="steadygrid"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="change-me-minioadmin123"
# Public base URL for stored objects (CDN override). Defaults to
# http(s)://MINIO_ENDPOINT:MINIO_PORT/MINIO_BUCKET when empty.
MINIO_PUBLIC_BASE_URL=""
# Local driver settings (used only when STORAGE_DRIVER=local)
STORAGE_DIR="./storage"
STORAGE_PUBLIC_BASE_URL=""
